#!/usr/bin/env bash
set -euo pipefail

: "${DATABASE_URL:?DATABASE_URL is required}"

readonly BACKUP_DIR="/var/backups/geo-system/postgres"
readonly STAMP="$(date +%Y%m%d-%H%M%S)"
readonly TARGET="${BACKUP_DIR}/geo-postgres-${STAMP}.dump"
readonly TEMPORARY="${TARGET}.tmp"

umask 077
install -d -m 700 "${BACKUP_DIR}"
trap 'rm -f "${TEMPORARY}"' EXIT

pg_dump \
  --dbname="${DATABASE_URL}" \
  --format=custom \
  --compress=6 \
  --no-owner \
  --no-privileges \
  --file="${TEMPORARY}"

mv "${TEMPORARY}" "${TARGET}"
chmod 600 "${TARGET}"
find "${BACKUP_DIR}" -type f -name 'geo-postgres-*.dump' -mtime +14 -delete
