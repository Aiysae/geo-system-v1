#!/usr/bin/env bash
set -euo pipefail

readonly PASSWORD_FILE="/etc/geo-system/redis-password"
readonly BACKUP_DIR="/var/backups/geo-system/redis"
readonly STAMP="$(date +%Y%m%d-%H%M%S)"
readonly RDB_PATH="${BACKUP_DIR}/redis-${STAMP}.rdb"

install -d -m 700 "${BACKUP_DIR}"
test -s "${PASSWORD_FILE}"

REDISCLI_AUTH="$(<"${PASSWORD_FILE}")" redis-cli -h 127.0.0.1 -n 0 --rdb "${RDB_PATH}" >/dev/null
gzip --force "${RDB_PATH}"
chmod 600 "${RDB_PATH}.gz"
find "${BACKUP_DIR}" -type f -name 'redis-*.rdb.gz' -mtime +14 -delete
