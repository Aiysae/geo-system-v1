# 生产环境变量模板 — 复制到服务器上一级目录并重命名为 .env.production
# 路径示例：/var/www/geo-strategy-system/.env.production
# 切勿将填好真实密钥的文件提交到 Git

# ── 本地账号 / Session ──
# 生成方式：openssl rand -base64 32
AUTH_SECRET=xxxxxxxx
# 管理员邮箱，多个用英文逗号分隔；这些邮箱注册/登录后可访问 /admin
ADMIN_EMAILS=admin@example.com
# 可选：设置后，新用户注册必须填写邀请码；留空则开放注册。
SIGN_UP_INVITE_CODE=

# ── 积分策略 ──
# 新账号默认试用积分；商业化后建议保持小额试用。
CREDITS_INITIAL=50
# 历史低余额账号补足阈值。商业化默认等于 CREDITS_INITIAL，避免自动补大额免费积分。
CREDITS_BOOTSTRAP_MIN=50
# 管理员账号默认不扣积分；如需强制所有账号免费，可设 CREDITS_MODE=unlimited。
ADMIN_CREDITS_UNLIMITED=true

# ── 充值收款说明（会展示给登录用户；不要填 API 密钥）──
NEXT_PUBLIC_RECHARGE_ACCOUNT_NAME=杭州势途数字科技有限公司
NEXT_PUBLIC_RECHARGE_CREDIT_CODE=91330114MAK8ML1T1N
NEXT_PUBLIC_RECHARGE_REGISTERED_ADDRESS=浙江省杭州市钱塘区河庄街道河景路598号12层1202室82号
NEXT_PUBLIC_RECHARGE_ACCOUNT_NO=3301041060008436135
NEXT_PUBLIC_RECHARGE_BANK_NAME=杭州银行股份有限公司环北支行
NEXT_PUBLIC_RECHARGE_BANK_CODE=313331000284
NEXT_PUBLIC_RECHARGE_CONTACT=
NEXT_PUBLIC_RECHARGE_WECHAT_QR_IMAGE_URL=/recharge/wechat-pay.jpg
NEXT_PUBLIC_RECHARGE_WECHAT_QR_LABEL=微信支付
NEXT_PUBLIC_RECHARGE_WECHAT_QR_DESC=推荐使用微信支付
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_IMAGE_URL=/recharge/alipay-pay.jpg
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_LABEL=支付宝
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_DESC=支持信用卡 / 花呗付款
NEXT_PUBLIC_RECHARGE_NOTICE=支持微信、支付宝或对公转账。付款后请填写付款人、付款凭证或流水号，管理员核对到账后审批加积分。

# ── Vercel KV / Upstash（积分与充值，阿里云 ECS 上可继续使用）──
# 生产环境建议明确选择存储后端：redis / vercel / file。
# file 仅用于单进程本地开发，不得用于商业化生产环境。
KV_BACKEND=redis
# 本机 Redis 示例：redis://:strong-password@127.0.0.1:6379/0
KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxx
KV_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://:strong-password@127.0.0.1:6379/0

# ── 客户工作区云端同步 ──
# 生产环境使用 PostgreSQL；file 仅供本地开发和应急回退。
WORKSPACE_STORE=postgres
DATABASE_URL=postgresql://geo_workspace:strong-password@127.0.0.1:5432/geo_workspace
WORKSPACE_DB_POOL_MAX=6
DATABASE_SSL=false
# WORKSPACE_STORE=file 时可选。
WORKSPACE_FILE=/var/lib/geo-system/workspaces.json

# ── DeepSeek ──
DEEPSEEK_API_KEY=sk-xxxxxxxx

# ── 火山方舟 / 豆包 ──
ARK_API_KEY=xxxxxxxx
ARK_DOUBAO_ENDPOINT_ID=ep-xxxxxxxx
ARK_DOUBAO_BOT_ID=bot-xxxxxxxx

# ── 通义千问（DashScope）──
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# ── Kimi（Moonshot）──
MOONSHOT_API_KEY=sk-xxxxxxxx
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn
MOONSHOT_CHAT_PATH=/v1/chat/completions

# ── 百度千帆 / 文心一言（V2 OpenAI 兼容接口）──
BAIDU_QIANFAN_API_KEY=bce-v3/xxxxxxxx
BAIDU_QIANFAN_MODEL=ernie-4.5-turbo-32k
BAIDU_QIANFAN_CHAT_URL=https://qianfan.baidubce.com/v2/chat/completions
# 可选：如果你的千帆应用要求 appid 头，填 app-xxxxxxxx
BAIDU_QIANFAN_APP_ID=
# 若所选模型不支持联网搜索，可设为 false
BAIDU_QIANFAN_ENABLE_SEARCH=true

# ── 腾讯元宝 / 混元（OpenAI 兼容接口）──
TENCENT_HUNYUAN_API_KEY=sk-xxxxxxxx
TENCENT_HUNYUAN_MODEL=hunyuan-turbos-latest
TENCENT_HUNYUAN_CHAT_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
# 仅确认当前混元模型/端点支持增强参数时再开启
TENCENT_HUNYUAN_ENABLE_ENHANCEMENT=false
