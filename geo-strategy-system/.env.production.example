# 生产环境变量模板 — 复制到服务器上一级目录并重命名为 .env.production
# 路径示例：/var/www/geo-strategy-system/.env.production
# 切勿将填好真实密钥的文件提交到 Git

# ── 本地账号 / Session ──
# 生成方式：openssl rand -base64 32
AUTH_SECRET=xxxxxxxx
# 中转站 API Key 的 AES-256-GCM 加密密钥；建议独立于 AUTH_SECRET。
# 生成方式：openssl rand -base64 32。留空时暂时回退使用 AUTH_SECRET。
AI_CONFIG_ENCRYPTION_KEY=xxxxxxxx
# 管理员邮箱，多个用英文逗号分隔；这些邮箱注册/登录后可访问 /admin
ADMIN_EMAILS=admin@example.com
ADMIN_NOTIFICATION_EMAILS=admin@example.com
# 可选：设置后，新用户注册必须填写邀请码；留空则开放注册。
SIGN_UP_INVITE_CODE=

# ── 注册、登录与密码重置邮箱验证码 ──
# 阿里云邮件推送（华东 1/杭州）默认地址。ECS 使用 465 SSL，不使用受限的 25 端口。
AUTH_EMAIL_SMTP_HOST=smtpdm.aliyun.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_SECURE=true
# 在阿里云邮件推送控制台创建的发信地址和 SMTP 密码。
AUTH_EMAIL_SMTP_USER=verify@notice.example.com
AUTH_EMAIL_SMTP_PASSWORD=xxxxxxxx
AUTH_EMAIL_FROM_ADDRESS=verify@notice.example.com
AUTH_EMAIL_FROM_NAME=势途 GEO
AUTH_EMAIL_REPLY_TO=
# 可选独立密钥；留空时使用 AUTH_SECRET 对验证码做 HMAC 保护。
AUTH_EMAIL_CODE_SECRET=

# ── 积分策略 ──
# 新账号默认试用积分；商业化后建议保持小额试用。
CREDITS_INITIAL=50
# 历史低余额账号补足阈值。商业化默认等于 CREDITS_INITIAL，避免自动补大额免费积分。
CREDITS_BOOTSTRAP_MIN=50
# 管理员账号默认不扣积分；如需强制所有账号免费，可设 CREDITS_MODE=unlimited。
ADMIN_CREDITS_UNLIMITED=true

# ── 充值收款说明（会展示给登录用户；不要填 API 密钥）──
NEXT_PUBLIC_RECHARGE_ACCOUNT_NAME=杭州势途数字科技有限公司
NEXT_PUBLIC_RECHARGE_CREDIT_CODE=91330114MAK8ML1T1N
NEXT_PUBLIC_RECHARGE_REGISTERED_ADDRESS=浙江省杭州市钱塘区河庄街道河景路598号12层1202室82号
NEXT_PUBLIC_RECHARGE_ACCOUNT_NO=3301041060008436135
NEXT_PUBLIC_RECHARGE_BANK_NAME=杭州银行股份有限公司环北支行
NEXT_PUBLIC_RECHARGE_BANK_CODE=313331000284
NEXT_PUBLIC_RECHARGE_CONTACT=
NEXT_PUBLIC_RECHARGE_WECHAT_QR_IMAGE_URL=/recharge/wechat-pay.jpg
NEXT_PUBLIC_RECHARGE_WECHAT_QR_LABEL=微信支付
NEXT_PUBLIC_RECHARGE_WECHAT_QR_DESC=推荐使用微信支付
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_IMAGE_URL=/recharge/alipay-pay.jpg
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_LABEL=支付宝
NEXT_PUBLIC_RECHARGE_ALIPAY_QR_DESC=支持信用卡 / 花呗付款
NEXT_PUBLIC_RECHARGE_NOTICE=支持微信、支付宝或对公转账。付款后请填写付款人、付款凭证或流水号，管理员核对到账后审批加积分。

# ── Vercel KV / Upstash（积分与充值，阿里云 ECS 上可继续使用）──
# 生产环境建议明确选择存储后端：redis / vercel / file。
# file 仅用于单进程本地开发，不得用于商业化生产环境。
KV_BACKEND=redis
# 本机 Redis 示例：redis://:strong-password@127.0.0.1:6379/0
KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxx
KV_REST_API_READ_ONLY_TOKEN=xxxxxxxx
KV_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379
REDIS_URL=redis://:strong-password@127.0.0.1:6379/0
# 长任务生产队列。Web 进程只创建任务，独立 PM2 Worker 消费并在重启后恢复。
TASK_QUEUE_BACKEND=bullmq
TASK_QUEUE_NAME=geo-long-tasks-v1
TASK_QUEUE_PREFIX=geo:bull
TASK_QUEUE_ATTEMPTS=3
TASK_WORKER_CONCURRENCY=4
TASK_WORKER_PENETRATION_CONCURRENCY=2
TASK_WORKER_GENERATION_CONCURRENCY=2
TASK_WORKER_UTILITY_CONCURRENCY=1
TASK_WORKER_LEGACY_CONCURRENCY=1
TASK_WORKER_LOCK_MS=900000
TASK_QUEUE_CLAIM_REFRESH_MS=60000

# ── 支付订单与官方支付通道 ──
# 正式环境使用 PostgreSQL 保存订单与回调事件；kv 只用于本地测试和应急回退。
PAYMENT_STORE=postgres
PAYMENT_DB_POOL_MAX=4
# 在商户产品、签名密钥、回调域名全部验证完成前保持关闭。
PAYMENT_ALIPAY_ENABLED=false
PAYMENT_WECHAT_ENABLED=false
# Native 审核通过且 AppID 已绑定后可开启；H5 必须等产品申请审核通过后再开启。
PAYMENT_WECHAT_NATIVE_ENABLED=true
PAYMENT_WECHAT_H5_ENABLED=false
PUBLIC_APP_URL=https://shitugeo.top
# 支付宝开放平台网页/移动应用配置。生产环境推荐使用 *_FILE 读取 600 权限密钥文件。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY_FILE=/etc/geo-system/payment/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_FILE=/etc/geo-system/payment/alipay-public-key.pem
ALIPAY_KEY_TYPE=PKCS8
# 可选：配置后会额外校验异步通知的 seller_id。
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 微信支付 API v3。生产环境推荐使用 *_FILE 读取服务器上的 600 权限密钥文件。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERT_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=/etc/geo-system/payment/apiclient_key.pem
WECHAT_PAY_API_V3_KEY_FILE=/etc/geo-system/payment/wechat-api-v3-key
WECHAT_PAY_PUBLIC_KEY_FILE=/etc/geo-system/payment/wechatpay_public_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
WECHAT_PAY_API_BACKUP_BASE=https://api2.mch.weixin.qq.com

# ── 客户工作区云端同步 ──
# 生产环境使用 PostgreSQL；file 仅供本地开发和应急回退。
WORKSPACE_STORE=postgres
TEAM_STORE=postgres
TEAM_FEATURE_ENABLED=true
DATABASE_URL=postgresql://geo_workspace:strong-password@127.0.0.1:5432/geo_workspace
WORKSPACE_DB_POOL_MAX=6
DATABASE_SSL=false
# WORKSPACE_STORE=file 时可选。
WORKSPACE_FILE=/var/lib/geo-system/workspaces.json

# ── 渗透率检测历史 ──
# 每次检测终态保存独立快照；列表只读摘要，详情按需读取完整回答与信源。
PENETRATION_HISTORY_STORE=postgres
PENETRATION_HISTORY_DB_POOL_MAX=2
# PENETRATION_HISTORY_STORE=file 时可选。
PENETRATION_HISTORY_FILE=/var/lib/geo-system/penetration-history.json

# ── 批量文章任务 ──
# 生产环境保存到同一 PostgreSQL；Word 文件在 ECS 私有目录缓存 30 天，正文长期保存在数据库。
ARTICLE_BATCH_STORE=postgres
ARTICLE_BATCH_DB_POOL_MAX=3
AI_USAGE_DB_POOL_MAX=2
ARTICLE_ARTIFACTS_DIR=/var/lib/geo-system/article-artifacts
# 2 核 4G 建议文章最多并发 2 个，并额外为其他后台功能保留一个执行通道。
ARTICLE_BACKGROUND_JOB_CONCURRENCY=2
BACKGROUND_JOB_TOTAL_CONCURRENCY=3
# 疑问句检测采用用户公平队列；当前 2 核 4G 服务器建议保持以下默认值。
PENETRATION_JOB_CONCURRENCY=3
PENETRATION_JOB_PER_USER_CONCURRENCY=1
PENETRATION_SCHEDULER_V2=true
PENETRATION_JOB_WAVE_BATCH_LIMIT=10
PENETRATION_JOB_WAVE_SLOT_LIMIT=24
PENETRATION_CREDENTIAL_WAIT_MS=8000
AI_CREDENTIAL_FAILOVER_ATTEMPTS=6
PENETRATION_PARTIAL_PERSIST_SLOT_INTERVAL=6
PENETRATION_PARTIAL_PERSIST_MIN_INTERVAL_MS=10000
# V2 独立参数不会被服务器上保留的 V1 限流值覆盖。
PENETRATION_V2_PROVIDER_TOTAL_CONCURRENCY=12
PENETRATION_V2_JUDGE_CONCURRENCY=3
PENETRATION_V2_DOUBAO_CONCURRENCY=3
PENETRATION_V2_DEEPSEEK_CONCURRENCY=8
PENETRATION_V2_QWEN_CONCURRENCY=8
PENETRATION_V2_KIMI_CONCURRENCY=4
PENETRATION_V2_ERNIE_CONCURRENCY=6
PENETRATION_V2_HUNYUAN_CONCURRENCY=3

# ── DeepSeek ──
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_WEB_SEARCH_MODEL=deepseek-v4-flash

# ── 火山方舟 / 豆包 ──
ARK_API_KEY=xxxxxxxx
ARK_DOUBAO_ENDPOINT_ID=ep-xxxxxxxx
ARK_DOUBAO_BOT_ID=bot-xxxxxxxx

# ── 通义千问（DashScope）──
DASHSCOPE_API_KEY=sk-xxxxxxxx
DASHSCOPE_MODEL=qwen-plus

# ── Kimi（Moonshot）──
MOONSHOT_API_KEY=sk-xxxxxxxx
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_BASE_URL=https://api.moonshot.cn
MOONSHOT_CHAT_PATH=/v1/chat/completions
# Kimi 严格检测由 Moonshot 生成与下方百度搜索双线路共同完成。

# ── 百度千帆 / 文心一言（V2 OpenAI 兼容接口）──
BAIDU_QIANFAN_API_KEY=bce-v3/xxxxxxxx
BAIDU_QIANFAN_MODEL=ernie-4.5-turbo-32k
BAIDU_QIANFAN_CHAT_URL=https://qianfan.baidubce.com/v2/chat/completions
# 可选：如果你的千帆应用要求 appid 头，填 app-xxxxxxxx
BAIDU_QIANFAN_APP_ID=
# 若所选模型不支持联网搜索，可设为 false
BAIDU_QIANFAN_ENABLE_SEARCH=true

# ── 腾讯元宝 / 混元（OpenAI 兼容接口）──
TENCENT_HUNYUAN_API_KEY=sk-xxxxxxxx
TENCENT_HUNYUAN_MODEL=hy3-preview
TENCENT_HUNYUAN_CHAT_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
# 仅确认当前混元模型/端点支持增强参数时再开启
TENCENT_HUNYUAN_ENABLE_ENHANCEMENT=true
